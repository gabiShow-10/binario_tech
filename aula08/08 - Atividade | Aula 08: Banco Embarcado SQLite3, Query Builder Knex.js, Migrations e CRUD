EXERCÍCIO 3: 

Crie uma nova Migration para criar a tabela 'motoristas' contendo os campos: id (primary key), nome (not nullable), cnh (unique, not nullable) e categoria (not nullable). Execute a migração via CLI. 
$ npx knex migrate:latest
npm notice run aula08@1.0.0 npx
npm notice run 'knex' migrate:latest
Using environment: development
Batch 2 run: 1 migrations
gabriel_b_silva11@cloudshell:~/curso-pbe1/binario_tech/aula08$ cat src/database/migrations/20260820190504_create_motoristas.js 
exports.up = function(knex) {
  return knex.schema.createTable('motoristas', function(table) {
    table.increments('id').primary();
    table.string('nome').notNullable();
    table.string('cnh').notNullable().unique();
    table.string('categoria').notNullable();
  });
};

exports.down = function(knex) {
  return knex.schema.dropTable('motoristas');
};


